pkgbase = omafile
	pkgdesc = Native GTK4/libadwaita file manager that follows the Omarchy theme
	pkgver = 0.21.0
	pkgrel = 1
	url = https://github.com/whogotpwned/omafile
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = curl
	makedepends = cargo
	depends = gtk4
	depends = libadwaita
	depends = vte4
	depends = glib2
	depends = hicolor-icon-theme
	optdepends = gvfs: trash, removable drives, SFTP servers, archive browsing
	optdepends = gvfs-afc: iPhone and iPad over USB
	optdepends = libimobiledevice: iPhone and iPad over USB
	optdepends = gvfs-mtp: Android phones over USB
	optdepends = gocryptfs: encrypted folders
	optdepends = git: status badges, stage, commit, branches
	optdepends = diffutils: compare files and folders
	optdepends = poppler: PDF thumbnails, previews, page turning, merge and split
	optdepends = fd: fast recursive search
	optdepends = ripgrep: full-text search
	optdepends = bat: syntax highlighting in previews
	optdepends = jq: formatted JSON in previews
	optdepends = libarchive: archives, eBook covers and metadata (bsdtar)
	optdepends = imagemagick: rotate, convert and resize images, font specimens, HEIC import
	optdepends = libheif: HEIC to JPEG when importing iPhone photos
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = ffmpeg: cover art, video tools, media facts
	optdepends = libpulse: Now Playing spectrum that follows the real sound (parec)
	optdepends = gst-plugins-good: play MP3, FLAC, Ogg and common video in the preview
	optdepends = gst-plugins-bad: more video codecs for the preview player
	optdepends = gst-libav: H.264 / AAC playback in the preview
	optdepends = webp-pixbuf-loader: animated WebP in the preview
	optdepends = qrencode: QR code for "Share on Local Network"
	optdepends = calibre: convert eBooks, eBook viewer
	optdepends = foliate: eBook reader
	optdepends = docker: container volumes in the sidebar (or podman)
	optdepends = uv: fast Python venv creation and installs from the Python menu
	optdepends = xdg-desktop-portal-hyprland: "Open With" chooser
	optdepends = uwsm: launch terminals and readers as session apps
	source = omafile-0.21.0.tar.gz::https://github.com/whogotpwned/omafile/archive/v0.21.0.tar.gz
	sha256sums = SKIP

pkgname = omafile
